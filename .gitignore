# ==========================================
# Environment & Secrets
# ==========================================
.env
.env.*
!.env.example
*.pem
*.key

# ==========================================
# Python / FastAPI
# ==========================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
.venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
wheels/

# Testing, linting & type checking caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# Local SQLite databases (remove if you intend to track a seed DB)
*.db
*.sqlite3

# ==========================================
# Node / React (Vite, Create React App, Next)
# ==========================================
# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Production builds
dist/
build/
.next/
out/

# Debug & package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# TypeScript & bundler caches
*.tsbuildinfo
.eslintcache
.parcel-cache/
.vite/

# Testing & coverage
coverage/
.nyc_output/

# ==========================================
# IDEs & Editors
# ==========================================
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ==========================================
# Operating System Files
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~
.directory
